#!/bin/sh
set -e

#
## Make /application group-owned and group-writable by www-data, and not
## world-writable: directories get setgid (new files inherit the group), files
## keep their own execute bit (X).
chown -R :www-data /application
chmod -R g+rwX,o-w /application
find /application -type d -exec chmod g+s {} +
