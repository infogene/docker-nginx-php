#!/bin/bash

COLOR_NONE="\033[m"
COLOR_BLUE="\033[34m"
COLOR_CYAN="\033[36m"
COLOR_LIGHT_GREEN="\033[1;32m"


## BLOCK HEADER
echo -e "$COLOR_LIGHT_GREEN"
figlet " $APP_NAME"
echo -e "$COLOR_BLUE By Infogene"
printf "\n"


## BLOCK SYSINFO
echo -e "$COLOR_CYAN\n"

proc="$(grep -c '^processor' /proc/cpuinfo) x $(awk -F': *' '/^model name/ {print $2; exit}' /proc/cpuinfo)"
memfree=$(awk '/^MemFree:/ {print $2}' /proc/meminfo)
memtotal=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
addrip=$(hostname -i | cut -d " " -f1)
read -r one five fifteen _ < /proc/loadavg

printf '  PROC : %s\n' "$proc"
printf '  CPU : %s (1min) / %s (5min) / %s (15min)\n' "$one" "$five" "$fifteen"
printf '  IP : %s\n' "$addrip"
printf '  RAM : %s MB Free / %s MB\n' "$((memfree / 1024))" "$((memtotal / 1024))"

echo -e "$COLOR_NONE"
