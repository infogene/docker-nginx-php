#!/bin/sh
set -e

#
## Disable PHP extension MOD: comment out the extension= / zend_extension= lines
## of the additional ini files whose path matches MOD (e.g. opcache, xdebug).
PHP_MOD=$1

if [ -n "${PHP_MOD}" ]; then
  php --ini | grep -oE '/[^,[:space:]]+\.ini' | grep -E "${PHP_MOD}" | while IFS= read -r PHP_MOD_INIFILE; do
    sed -i -e 's/^[[:space:]]*\(\(zend_\)\{0,1\}extension\)[[:space:]]*=/;\1=/' "${PHP_MOD_INIFILE}"
  done
fi
