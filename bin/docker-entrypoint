#!/usr/bin/env bash

# Strict error handling
set -Eeuo pipefail

# Constants
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)"
readonly SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"

# Color codes (populated by setup_colors)
declare NOFORMAT RED GREEN ORANGE BLUE PURPLE CYAN YELLOW

# Configuration flags
declare -i ENABLE_XDEBUG=0
declare -i MODE_DEV=0
declare -i MODE_PROD=0
declare -i START_CRON=0
declare -i START_BACKEND=0
declare -i START_FRONTEND=0
declare -i START_SUPERVISOR_CLI=0
declare -a SUPERVISOR_ARGS=()
declare BACKEND_CMD=""
declare FRONTEND_CMD=""
declare BOOT_CMD="${APP_BOOT_CMD:-}"
declare CLI_CMD=""

# Trap cleanup on exit
trap cleanup SIGINT SIGTERM ERR EXIT

#######################################
# Cleanup function called on exit
#######################################
cleanup() {
  trap - SIGINT SIGTERM ERR EXIT
  # Add cleanup logic here if needed
}

#######################################
# Setup terminal colors
#######################################
setup_colors() {
  if [[ -t 2 ]] && [[ -z "${NO_COLOR:-}" ]] && [[ "${TERM:-}" != "dumb" ]]; then
    NOFORMAT='\033[0m'
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    ORANGE='\033[0;33m'
    BLUE='\033[0;34m'
    PURPLE='\033[0;35m'
    CYAN='\033[0;36m'
    YELLOW='\033[1;33m'
  else
    NOFORMAT='' RED='' GREEN='' ORANGE='' BLUE='' PURPLE='' CYAN='' YELLOW=''
  fi
}

#######################################
# Print message to stderr
# Arguments:
#   Message to print
#######################################
msg() {
  echo >&2 -e "${1-}"
}

#######################################
# Print error and exit
# Arguments:
#   Error message
#   Exit code (default: 1)
#######################################
die() {
  local msg=$1
  local code=${2-1}
  msg "${RED}ERROR: ${msg}${NOFORMAT}"
  exit "$code"
}

#######################################
# Check whether a value is truthy (1 or true)
# Arguments:
#   Value to check
#######################################
is_true() {
  [[ "${1:-}" =~ ^(1|true)$ ]]
}

#######################################
# Print usage information
#######################################
usage() {
  cat <<EOF
Usage: ${SCRIPT_NAME} [OPTIONS] [ARGS...]

Docker entrypoint for PHP/Node.js application with multiple runtime modes.

OPTIONS:
  -h, --help              Show this help message and exit
  -v, --verbose           Enable verbose output (set -x)
  --no-color              Disable colored output

  Mode Options:
  --mode-dev              Run in development mode (enables xdebug)
  --mode-prod             Run in production mode (default)
  --enable-xdebug         Explicitly enable xdebug

  Service Options (when none is given, --start-backend is implied):
  --start-cron            Run the www-data crontab (/var/spool/cron/crontabs/www-data)
                          with supercronic, no other service
  --start-backend [CMD]   Start backend. Default: Nginx + PHP-FPM.
                          Optional CMD overrides it, e.g.
                          --start-backend "php -S 0.0.0.0:8080 -t /application/public"
  --start-frontend [CMD]  Start frontend. Default: yarn --cwd frontend <env>.
                          Optional CMD overrides it.
  --start-all             Start backend and frontend with their default commands
  --start-supervisor-cli  Generate a supervisord config from --supervisor-* args
                          and run supervisord (see docker-supervisor-cli --help)

  Supervisor Options (only with --start-supervisor-cli, forwarded as-is):
  --supervisor-program "<cmd>"     Command to supervise (required)
  --supervisor-program-name NAME   Program name (default: app)
  --supervisor-<a>-<b> VALUE       Any supervisor directive -> a_b=VALUE

  Execution Options:
  --boot-cmd COMMAND      Run command during bootstrap (e.g., "php bin/console cache:clear")
  --cli COMMAND           Run COMMAND (through bash -c) and exit, no service

  --cli, --start-cron and the --start-* services are mutually exclusive, as are
  --mode-dev and --mode-prod.

ARGUMENTS:
  If any arguments are provided, they will be executed directly,
  and all options will be ignored (passthrough mode).

ENVIRONMENT VARIABLES:
  APP_ENV                       Application environment (dev/prod)
  APP_BOOT_CMD                  Default boot command
  APP_BOOT_PERMS_FLUSH          If 1/true, adjust /application permissions at startup
  APP_BOOT_PHP_XDEBUG_ENABLED   If 1/true, enable xdebug (requires root)
  APP_BOOT_PHP_EXT_ENABLED      Space-separated PHP extensions to enable (requires root)
  PHP_*, PHP_FPM_PM*            php.ini / PHP-FPM settings (see README)
  NGINX_CLIENT_MAX_BODY_SIZE    Nginx request body limit (default: PHP_POST_MAX_SIZE)

EXAMPLES:
  # Start in production mode with backend only
  ${SCRIPT_NAME} --start-backend --mode-prod

  # Start in dev mode with all services
  ${SCRIPT_NAME} --start-all --mode-dev

  # Run a CLI command
  ${SCRIPT_NAME} --cli "php bin/console app:command"

  # Passthrough mode (run bash)
  ${SCRIPT_NAME} bash

EOF
  exit 0
}

#######################################
# Parse command line parameters
# Arguments:
#   All command line arguments
#######################################
parse_params() {
  local args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        ;;
      -v|--verbose)
        set -x
        shift
        ;;
      --no-color)
        NO_COLOR=1
        shift
        ;;
      --enable-xdebug)
        ENABLE_XDEBUG=1
        shift
        ;;
      --mode-dev)
        MODE_DEV=1
        shift
        ;;
      --mode-prod)
        MODE_PROD=1
        shift
        ;;
      --start-cron)
        START_CRON=1
        shift
        ;;
      --start-backend)
        START_BACKEND=1
        # Optional command override: consume $2 only if it isn't another option
        if [[ $# -ge 2 && "$2" != -* ]]; then
          BACKEND_CMD="$2"
          shift 2
        else
          shift
        fi
        ;;
      --start-frontend)
        START_FRONTEND=1
        # Optional command override: consume $2 only if it isn't another option
        if [[ $# -ge 2 && "$2" != -* ]]; then
          FRONTEND_CMD="$2"
          shift 2
        else
          shift
        fi
        ;;
      --start-all)
        START_BACKEND=1
        START_FRONTEND=1
        shift
        ;;
      --start-supervisor-cli)
        START_SUPERVISOR_CLI=1
        shift
        ;;
      --supervisor-*)
        # Collected verbatim and forwarded to docker-supervisor-cli
        [[ $# -ge 2 ]] || die "Missing value for $1"
        SUPERVISOR_ARGS+=("$1" "$2")
        shift 2
        ;;
      --boot-cmd)
        BOOT_CMD="${2:-}"
        [[ -z "$BOOT_CMD" ]] && die "Missing value for --boot-cmd"
        shift 2
        ;;
      --cli)
        CLI_CMD="${2:-}"
        [[ -z "$CLI_CMD" ]] && die "Missing value for --cli"
        shift 2
        ;;
      -?*)
        die "Unknown option: $1"
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done

  # If arguments provided, enable passthrough mode
  if [[ ${#args[@]} -gt 0 ]]; then
    exec "${args[@]}"
  fi

  validate_params

  # Determine mode based on flags and environment
  if [[ $MODE_DEV -eq 0 && $MODE_PROD -eq 0 ]]; then
    if [[ "${APP_ENV:-prod}" == "dev" ]]; then
      MODE_DEV=1
    else
      MODE_PROD=1
    fi
  fi

  if is_true "${APP_BOOT_PHP_XDEBUG_ENABLED:-}"; then
    ENABLE_XDEBUG=1
  fi

  # Mode-specific settings
  if [[ $MODE_DEV -eq 1 ]]; then
    MODE_PROD=0
    ENABLE_XDEBUG=1
  fi

  if [[ $MODE_PROD -eq 1 ]]; then
    MODE_DEV=0
  fi
}

#######################################
# Reject contradictory options, and default to the backend when no service
# nor one-off command is requested.
#######################################
validate_params() {
  [[ $MODE_DEV -eq 1 && $MODE_PROD -eq 1 ]] \
    && die "--mode-dev and --mode-prod are mutually exclusive"

  local -i run_modes=0
  [[ -n "$CLI_CMD" ]] && run_modes+=1
  [[ $START_CRON -eq 1 ]] && run_modes+=1
  [[ $START_BACKEND -eq 1 || $START_FRONTEND -eq 1 || $START_SUPERVISOR_CLI -eq 1 ]] && run_modes+=1
  [[ $run_modes -gt 1 ]] \
    && die "--cli, --start-cron and the --start-* services are mutually exclusive"

  if [[ $run_modes -eq 0 ]]; then
    START_BACKEND=1
  fi
  return 0
}

#######################################
# Enable PHP xdebug extension
#######################################
enable_xdebug() {
  [[ $ENABLE_XDEBUG -eq 0 ]] && return 0

  if [[ $(id -u) -ne 0 ]]; then
    msg "${YELLOW}  ⚠ xdebug not enabled: requires running the container as root${NOFORMAT}"
    return 0
  fi

  if ! php -m | grep -q "xdebug"; then
    msg "${CYAN}  ↳ Enabling xdebug...${NOFORMAT}"
    docker-php-ext-enable xdebug &>/dev/null || die "Failed to enable xdebug"
  fi
}

#######################################
# Enable the PHP extensions listed in APP_BOOT_PHP_EXT_ENABLED
#######################################
enable_php_extensions() {
  [[ -z "${APP_BOOT_PHP_EXT_ENABLED:-}" ]] && return 0

  if [[ $(id -u) -ne 0 ]]; then
    msg "${YELLOW}  ⚠ PHP extensions (${APP_BOOT_PHP_EXT_ENABLED}) not enabled: requires running the container as root${NOFORMAT}"
    return 0
  fi

  msg "${CYAN}  ↳ Enabling PHP extensions (${APP_BOOT_PHP_EXT_ENABLED})...${NOFORMAT}"
  # shellcheck disable=SC2086 # space-separated list, split on purpose
  docker-php-ext-enable ${APP_BOOT_PHP_EXT_ENABLED} &>/dev/null \
    || die "Failed to enable PHP extensions: ${APP_BOOT_PHP_EXT_ENABLED}"
}

#######################################
# Adjust /application permissions when APP_BOOT_PERMS_FLUSH is set
#######################################
flush_permissions() {
  is_true "${APP_BOOT_PERMS_FLUSH:-}" || return 0

  msg "${CYAN}  ↳ Adjusting /application permissions...${NOFORMAT}"
  docker-permissions-flush || die "Permissions flush failed"
}

#######################################
# Configure development mode
#######################################
setup_dev_mode() {
  [[ $MODE_DEV -eq 0 ]] && return 0

  export APP_ENV=dev
  msg "${GREEN}  ↳ Running in DEVELOPMENT MODE${NOFORMAT}"
  msg "${CYAN}    APP_ENV=${APP_ENV}${NOFORMAT}"

  # Configure git safe directory
  if command -v docker-exec-www-data &>/dev/null; then
    docker-exec-www-data git config --global --get-all safe.directory 2>/dev/null | grep -qx /application \
      || docker-exec-www-data git config --global --add safe.directory /application 2>/dev/null \
      || true
  fi
}

#######################################
# Configure production mode
#######################################
setup_prod_mode() {
  [[ $MODE_PROD -eq 0 ]] && return 0

  export APP_ENV=prod
  msg "${GREEN}  ↳ Running in PRODUCTION MODE${NOFORMAT}"
  msg "${CYAN}    APP_ENV=${APP_ENV}${NOFORMAT}"
}

#######################################
# Run bootstrap command
#######################################
run_boot_command() {
  [[ -z "$BOOT_CMD" ]] && return 0

  msg "${CYAN}  ↳ Running bootstrap command...${NOFORMAT}"
  msg "${CYAN}    Command: ${BOOT_CMD}${NOFORMAT}"

  docker-exec-www-data bash -c "$BOOT_CMD" || die "Boot command failed"
}

#######################################
# Run CLI command and exit
#######################################
run_cli_mode() {
  [[ -z "$CLI_CMD" ]] && return 0

  msg "${CYAN}  ↳ Running CLI command...${NOFORMAT}"

  exec docker-exec-www-data bash -c "$CLI_CMD"
}

#######################################
# Start cron service
# Runs the www-data crontab with supercronic: unlike crond/cron it needs no root
# (no user switch per job), reads the file whatever its mode, and logs jobs to
# stdout/stderr.
#######################################
start_cron() {
  [[ $START_CRON -eq 0 ]] && return 0

  local crontab_file="/var/spool/cron/crontabs/www-data"
  [[ -r "$crontab_file" ]] || die "Crontab not found or not readable: ${crontab_file}"

  msg "${GREEN}  ↳ Starting cron service (supercronic)...${NOFORMAT}"

  exec docker-exec-www-data supercronic "$crontab_file"
}

#######################################
# Register a program to be managed by Supervisor.
# Appends a --supervisor-program block to SUPERVISOR_ARGS and arms the dispatcher.
# Arguments:
#   1: command line to run
#   2: program name
#   3+: extra --supervisor-* option/value pairs for this program
#######################################
register_supervisor_program() {
  SUPERVISOR_ARGS+=(--supervisor-program "$1" --supervisor-program-name "$2" "${@:3}")
  START_SUPERVISOR_CLI=1
}

#######################################
# Register frontend service (managed by Supervisor as user www-data)
#######################################
start_frontend() {
  [[ $START_FRONTEND -eq 0 ]] && return 0

  # Default command unless overridden via --start-frontend "<cmd>"
  local cmd="${FRONTEND_CMD:-yarn --cwd frontend ${APP_ENV:-dev}}"

  msg "${GREEN}  ↳ Registering frontend server (Supervisor)...${NOFORMAT}"
  register_supervisor_program "$cmd" "frontend"
}

#######################################
# Start Supervisor with a CLI-generated config
# Forwards all collected --supervisor-* args to docker-supervisor-cli,
# which generates the supervisord.conf and execs supervisord.
#######################################
start_supervisor_cli() {
  [[ $START_SUPERVISOR_CLI -eq 0 ]] && return 0

  msg "${GREEN}  ↳ Starting Supervisor (CLI-generated config)...${NOFORMAT}"
  echo ""

  command -v docker-supervisor-cli &>/dev/null \
    || die "docker-supervisor-cli command not found"

  exec docker-supervisor-cli "${SUPERVISOR_ARGS[@]}"
}

#######################################
# Render the runtime part of the nginx vhost from environment variables, in
# /tmp/nginx (included by conf/nginx.vhost.conf; /tmp stays writable under a
# read-only root filesystem).
#######################################
render_nginx_runtime_conf() {
  local size="${NGINX_CLIENT_MAX_BODY_SIZE:-${PHP_POST_MAX_SIZE:-10M}}"
  [[ "$size" =~ ^[0-9]+[kKmMgG]?$ ]] || die "Invalid NGINX_CLIENT_MAX_BODY_SIZE: ${size}"

  mkdir -p /tmp/nginx
  printf 'client_max_body_size %s;\n' "$size" > /tmp/nginx/runtime.conf
}

#######################################
# Register backend services (Nginx + PHP-FPM) as separate Supervisor programs,
# so each is supervised and restarted independently.
#######################################
start_backend() {
  [[ $START_BACKEND -eq 0 ]] && return 0

  # Custom command overrides the default Nginx + PHP-FPM pair
  if [[ -n "$BACKEND_CMD" ]]; then
    msg "${GREEN}  ↳ Registering backend (custom command) (Supervisor)...${NOFORMAT}"
    register_supervisor_program "$BACKEND_CMD" "backend"
    return 0
  fi

  msg "${GREEN}  ↳ Registering Nginx + PHP-FPM (Supervisor)...${NOFORMAT}"
  render_nginx_runtime_conf

  # Graceful stop: QUIT lets both finish in-flight requests (TERM drops them).
  # PHP-FPM waits up to process_control_timeout (conf/php-fpm.conf) for its
  # workers; stopwaitsecs leaves supervisord time before it sends SIGKILL.
  local -a graceful_stop=(--supervisor-stopsignal QUIT --supervisor-stopwaitsecs 25)

  register_supervisor_program "php-fpm -F" "php-fpm" "${graceful_stop[@]}"

  # nginx global directives. When the container runs as root the nginx master is
  # root and would spawn workers as its compiled-in default user (nginx, uid 100),
  # which cannot write the www-data-owned runtime dirs (/var/lib/nginx/tmp/...),
  # breaking request-body buffering on uploads. Pin workers to www-data — the
  # owner of those dirs. Done only as root: a non-root master can't switch user
  # and nginx would just warn about the directive.
  local nginx_g="daemon off;"
  if [[ $(id -u) -eq 0 ]]; then
    nginx_g="user www-data; ${nginx_g}"
  fi
  register_supervisor_program "nginx -g \"${nginx_g}\"" "nginx" "${graceful_stop[@]}"
}

#######################################
# Main execution flow
#######################################
main() {
  setup_colors
  parse_params "$@"

  msg "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NOFORMAT}"
  msg "${BLUE}  Starting entrypoint...${NOFORMAT}"
  msg "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NOFORMAT}"

  # Setup phase
  enable_xdebug
  enable_php_extensions
  flush_permissions
  setup_dev_mode
  setup_prod_mode
  run_boot_command

  # Execution phase
  run_cli_mode          # Exits if CLI mode
  start_cron            # Exits if cron mode

  # Register requested services as Supervisor programs, then hand off to a
  # single supervisord that manages them all (backend + frontend together).
  start_backend         # Registers Nginx + PHP-FPM
  start_frontend        # Registers frontend
  start_supervisor_cli  # Execs docker-supervisor-cli with all registered programs

  # Unreachable: validate_params guarantees a run mode, and each one execs
  die "No service started. Use --help for usage information."
}

# Execute main function
main "$@"